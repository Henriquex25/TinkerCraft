{
  "name": "tinkercraft",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "go test ./...",
    "test:ui": "node tests/ui.test.mjs && node tests/invitation.test.mjs",
    "test:render": "node tests/render.test.mjs",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css,json}\" frontend/vite.config.ts \"tests/*.mjs\" \".github/**/*.{yml,json}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css,json}\" frontend/vite.config.ts \"tests/*.mjs\" \".github/**/*.{yml,json}\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "php-parser": "3.7.0",
    "playwright-core": "1.58.2",
    "prettier": "3.9.10"
  }
}
